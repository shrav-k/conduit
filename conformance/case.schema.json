                      "caller": {
                        "type": "string",
                        "minLength": 1
                      },
                      "conduit": {
                        "type": "string",
                        "minLength": 1
                      },
                      "target": {
                        "type": "string",
                        "minLength": 1
                      },
                      "operation": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "sender",
                      "caller",
                      "conduit",
                      "target",
                      "operation"
