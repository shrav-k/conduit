                      },
                      "ids": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "revisions": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "suffixes": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "time",
                      "ids"
                    ]
                  },
                  "request": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "sender": {
                        "type": "string",
                        "minLength": 1
                      },
                      "caller": {
                        "type": "string",
                        "minLength": 1
                      },
                      "conduit": {
                        "type": "string",
