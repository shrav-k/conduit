{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "First-build portable case (runner convention)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "language",
          "convention",
          "interface"
        ]
      }
    },
    "promises": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3,5}-[0-9]{3}$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "first-build"
    },
    "initial": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipe": {
              "const": "empty"
            }
          },
          "required": [
            "recipe"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipe": {
              "const": "snapshot"
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "recipe",
            "file"
          ]
        }
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
