                    "reply",
                    "records",
                    "external_intents",
                    "required_promises",
                    "stateUnchanged"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "input": {
                  "properties": {
                    "kind": {
                      "not": {
                        "enum": [
                          "access-fixture",
                          "invoke",
                          "request-fixture",
                          "lifecycle-fixture",
                          "setup-report",
                          "clock",
                          "machine-report"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "properties": {
                    "records": {
                      "items": {
                        "if": {
                          "properties": {
