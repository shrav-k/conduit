{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "First-build portable case (runner convention)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "language",
          "convention",
          "interface"
        ]
      }
    },
    "promises": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{3,5}-[0-9]{3}$"
      }
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "const": "first-build"
    },
    "initial": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipe": {
              "const": "empty"
            }
          },
          "required": [
            "recipe"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "recipe": {
              "const": "snapshot"
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "recipe",
            "file"
          ]
        }
      ]
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "oneOf": [
              false
            ]
          },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          },
          "capture": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "input",
          "expect"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "input": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "first-start",
                        "request",
                        "submit-files",
                        "register-project",
                        "registration-orders",
                        "install-archive"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "required": [
                    "reply",
                    "records",
                    "external_intents",
                    "required_promises"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "state"
                      ]
                    },
                    {
                      "required": [
                        "stateUnchanged"
                      ]
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "input": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "read",
                        "load"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "required": [
                    "accepted",
                    "diagnostics"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "input": {
                  "properties": {
                    "kind": {
                      "const": "validate-values"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "required": [
                    "valid"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "input": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "read",
                        "load"
                      ]
                    }
                  }
                },
                "expect": {
                  "properties": {
                    "accepted": {
                      "const": true
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "required": [
                    "document_count"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "input": {
                  "properties": {
                    "kind": {
                      "const": "resolve-project"
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "required": [
                    "reply",
                    "records",
                    "external_intents",
                    "required_promises",
                    "stateUnchanged"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "input": {
                  "properties": {
                    "kind": {
                      "not": {
                        "enum": [
                          "access-fixture",
                          "invoke",
                          "request-fixture",
                          "lifecycle-fixture",
                          "setup-report"
                        ]
                      }
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "expect": {
                  "properties": {
                    "records": {
                      "items": {
                        "properties": {
                          "data": {
                            "required": [
                              "target"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "layers",
    "promises",
    "title",
    "profile",
    "initial",
    "files",
    "steps"
  ]
}
