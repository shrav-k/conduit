                  "invocation",
                  "attempt",
                  "completion"
                ]
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "const": "cancel"
                  },
                  "evidence": {
                    "type": "object"
                  },
                  "invocation": {
                    "type": "string"
