[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Operation",
    "metadata": {
      "name": "configure.v1"
    },
    "spec": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "$ref": "github.com/shrav-k/conduit/core#revision.v1"
          },
          "limit": {
            "type": "integer"
          },
          "label": {
            "type": "string",
            "default": "default label"
          }
        },
        "required": [
          "revision"
        ],
        "additionalProperties": false
      },
      "changes": {
        "limit": "/limit",
        "label": "/label"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Capability",
    "metadata": {
      "name": "settings.v1"
    },
    "spec": {
      "operations": [
        "#configure.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Type",
    "metadata": {
      "name": "scripted-agent.v1"
    },
    "spec": {
      "family": "Agent",
      "schema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "limit",
          "label"
        ],
        "additionalProperties": false
      },
      "offers": [
        "#settings.v1"
      ],
      "requires": [],
      "implementation": {
        "#configure.v1": "#scripted"
      },
      "controls": [
        "#configure.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "agent-template"
    },
    "spec": {
      "type": "#scripted-agent.v1",
      "config": {
        "limit": 10,
        "label": "original"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Fleet",
    "metadata": {
      "name": "fleet"
    },
    "from": "github.com/shrav-k/conduit/core#fleet"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "agent"
    },
    "from": "agent-template",
    "owner": "fleet"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "configure"
    },
    "spec": {
      "capability": "#settings.v1",
      "operations": [
        "#configure.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "root-settings"
    },
    "from": "configure",
    "consumer": {
      "kind": "Interface",
      "name": "root"
    },
    "target": {
      "kind": "Agent",
      "name": "agent"
    }
  }
]
