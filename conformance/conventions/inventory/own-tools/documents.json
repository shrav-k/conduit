[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Operation",
    "metadata": {
      "name": "ping.v1"
    },
    "spec": {
      "effect": "A fixture effect.",
      "inputSchema": {
        "type": "object"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Operation",
    "metadata": {
      "name": "work.v1"
    },
    "spec": {
      "effect": "Starts fixture model work.",
      "startsModelWork": true,
      "inputSchema": {
        "type": "object"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Capability",
    "metadata": {
      "name": "tools-access.v1"
    },
    "spec": {
      "operations": [
        "#ping.v1",
        "#work.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Type",
    "metadata": {
      "name": "tools-agent.v1"
    },
    "spec": {
      "family": "Agent",
      "schema": {
        "type": "object",
        "properties": {
          "directory": {
            "type": [
              "string",
              "null"
            ],
            "default": null
          }
        },
        "required": [
          "directory"
        ],
        "additionalProperties": false
      },
      "toolsDirectory": {
        "directory": "/directory"
      },
      "offers": [
        "#tools-access.v1"
      ],
      "implementation": {
        "#ping.v1": "#fixture-server",
        "#work.v1": "#fixture-server"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Fleet",
    "metadata": {
      "name": "group"
    },
    "from": "github.com/shrav-k/conduit/core#fleet"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "named-template"
    },
    "spec": {
      "type": "#tools-agent.v1",
      "config": {
        "directory": "/work"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "named"
    },
    "from": "named-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "empty-template"
    },
    "spec": {
      "type": "#tools-agent.v1",
      "config": {
        "directory": ""
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "empty"
    },
    "from": "empty-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "cleared-template"
    },
    "spec": {
      "type": "#tools-agent.v1",
      "config": {
        "directory": null
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "cleared"
    },
    "from": "cleared-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "defaulted-template"
    },
    "spec": {
      "type": "#tools-agent.v1",
      "config": {}
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "defaulted"
    },
    "from": "defaulted-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Interface",
    "metadata": {
      "name": "holder-template"
    },
    "spec": {
      "type": "github.com/shrav-k/conduit/core#interface.v1"
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Interface",
    "metadata": {
      "name": "holder"
    },
    "from": "holder-template"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "ping-template"
    },
    "spec": {
      "capability": "#tools-access.v1",
      "operations": [
        "#ping.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "holder-ping"
    },
    "from": "ping-template",
    "consumer": {
      "kind": "Interface",
      "name": "holder"
    },
    "target": {
      "kind": "Agent",
      "name": "named"
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "work-template"
    },
    "spec": {
      "capability": "#tools-access.v1",
      "operations": [
        "#work.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "holder-work"
    },
    "from": "work-template",
    "consumer": {
      "kind": "Interface",
      "name": "holder"
    },
    "target": {
      "kind": "Agent",
      "name": "named"
    }
  }
]
