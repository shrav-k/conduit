[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Operation",
    "metadata": {
      "name": "ping.v1"
    },
    "spec": {
      "effect": "A fixture effect.",
      "inputSchema": {
        "type": "object"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Capability",
    "metadata": {
      "name": "item-access.v1"
    },
    "spec": {
      "operations": [
        "#ping.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "ping"
    },
    "spec": {
      "capability": "#item-access.v1",
      "operations": [
        "#ping.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Operation",
    "metadata": {
      "name": "set-limit.v1"
    },
    "spec": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "revision": {
            "$ref": "github.com/shrav-k/conduit/core#revision.v1"
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "revision"
        ],
        "additionalProperties": false
      },
      "changes": {
        "limit": "/limit"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Type",
    "metadata": {
      "name": "signed-agent.v1"
    },
    "spec": {
      "family": "Agent",
      "schema": {
        "type": "object",
        "properties": {
          "account": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "account"
        ]
      },
      "requires": [
        "github.com/shrav-k/conduit/core#sign-in-hook.v1",
        "github.com/shrav-k/conduit/core#account-hook.v1",
        "github.com/shrav-k/conduit/core#sign-out-hook.v1"
      ],
      "signIn": {
        "account": "/account",
        "logins": [
          {
            "name": "browser",
            "return": "redirect",
            "authorization": "https://example.org/authorize",
            "clientId": "placeholder-signed-agent",
            "redirect": {
              "host": "127.0.0.1",
              "ports": [
                8400,
                8401
              ],
              "path": "/callback"
            },
            "carried": true
          },
          {
            "name": "device",
            "return": "device",
            "authorization": "https://example.org/device",
            "clientId": "placeholder-signed-agent"
          }
        ]
      },
      "controls": [
        "#set-limit.v1"
      ],
      "offers": [
        "#item-access.v1"
      ],
      "implementation": {
        "#ping.v1": "#signed-server",
        "#set-limit.v1": "#signed-server",
        "github.com/shrav-k/conduit/core#sign-in-hook.v1": "#signed-server",
        "github.com/shrav-k/conduit/core#account-hook.v1": "#signed-server",
        "github.com/shrav-k/conduit/core#sign-out-hook.v1": "#signed-server"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "signed-template"
    },
    "spec": {
      "type": "#signed-agent.v1",
      "config": {
        "account": "primary-account"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "unset-template"
    },
    "spec": {
      "type": "#signed-agent.v1",
      "config": {
        "account": null
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Fleet",
    "metadata": {
      "name": "group"
    },
    "from": "github.com/shrav-k/conduit/core#fleet"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "signed"
    },
    "from": "signed-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "unset"
    },
    "from": "unset-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "paired"
    },
    "from": "signed-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "third"
    },
    "from": "signed-template",
    "owner": "group"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "to-signed"
    },
    "from": "ping",
    "consumer": {
      "kind": "Interface",
      "name": "root"
    },
    "target": {
      "kind": "Agent",
      "name": "signed"
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "to-unset"
    },
    "from": "ping",
    "consumer": {
      "kind": "Interface",
      "name": "root"
    },
    "target": {
      "kind": "Agent",
      "name": "unset"
    }
  }
]
