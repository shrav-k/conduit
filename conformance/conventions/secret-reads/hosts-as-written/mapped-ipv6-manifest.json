{
  "apiVersion": "github.com/shrav-k/conduit/v0",
  "address": "example.org/board",
  "implementations": {
    "status-board": {
      "implements": [
        "#board.read.v1"
      ],
      "remote": {
        "type": "streamable-http",
        "url": "http://[::ffff:127.0.0.1]/mcp",
        "headers": [
          {
            "name": "X-Board-Key",
            "isRequired": true,
            "isSecret": true
          }
        ]
      },
      "headers": {
        "X-Board-Key": "/key"
      },
      "plain": true,
      "tools": {
        "#board.read.v1": "read_status"
      }
    }
  }
}
