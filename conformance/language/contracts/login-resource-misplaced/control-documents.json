[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Type",
    "metadata": {
      "name": "shared-agent.v1"
    },
    "spec": {
      "family": "Agent",
      "schema": {
        "type": "object",
        "properties": {
          "login": {
            "$ref": "github.com/shrav-k/conduit/core#resource-reference.v1"
          }
        },
        "required": [
          "login"
        ]
      },
      "loginResource": {
        "place": "/login"
      },
      "controls": [
        "#move-login.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Operation",
    "metadata": {
      "name": "move-login.v1"
    },
    "spec": {
      "changes": {
        "login": "/login"
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "login": {
            "$ref": "github.com/shrav-k/conduit/core#resource-reference.v1"
          },
          "revision": {
            "$ref": "github.com/shrav-k/conduit/core#revision.v1"
          }
        },
        "required": [
          "revision"
        ],
        "additionalProperties": false
      }
    }
  }
]
