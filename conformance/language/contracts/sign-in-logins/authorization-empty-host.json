{
  "apiVersion": "github.com/shrav-k/conduit/v0",
  "kind": "Type",
  "metadata": {
    "name": "signed-agent.v1"
  },
  "spec": {
    "family": "Agent",
    "schema": {
      "type": "object",
      "properties": {
        "account": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "account"
      ]
    },
    "requires": [
      "github.com/shrav-k/conduit/core#sign-in-hook.v1",
      "github.com/shrav-k/conduit/core#account-hook.v1",
      "github.com/shrav-k/conduit/core#sign-out-hook.v1"
    ],
    "signIn": {
      "account": "/account",
      "logins": [
        {
          "name": "browser",
          "return": "redirect",
          "authorization": "https://",
          "clientId": "placeholder-agent-browser",
          "redirect": {
            "host": "127.0.0.1",
            "ports": [
              8400,
              8401
            ],
            "path": "/callback"
          },
          "carried": true,
          "issuer": "https://example.org"
        },
        {
          "name": "device",
          "return": "device",
          "authorization": "https://example.org/device",
          "clientId": "placeholder-agent-device"
        }
      ]
    }
  }
}
