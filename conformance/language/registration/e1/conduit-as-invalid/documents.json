[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "link"
    },
    "spec": {
      "capability": "github.com/shrav-k/conduit/core#object-management.v1",
      "operations": [
        "github.com/shrav-k/conduit/core#inspect.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "long-link"
    },
    "from": "link",
    "consumer": {
      "kind": "Interface",
      "name": "delegate"
    },
    "target": {
      "kind": "Resource",
      "name": "management"
    },
    "arguments": {
      "as": "local"
    }
  }
]
