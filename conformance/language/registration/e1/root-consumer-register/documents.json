[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "link"
    },
    "spec": {
      "capability": "github.com/shrav-k/conduit/core#object-management.v1",
      "operations": [
        "github.com/shrav-k/conduit/core#inspect.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "long-link"
    },
    "from": "link",
    "consumer": {
      "kind": "Interface",
      "name": "root"
    },
    "target": {
      "kind": "Resource",
      "name": "management"
    },
    "as": "root-new"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Interface",
    "metadata": {
      "name": "person"
    },
    "spec": {
      "type": "github.com/shrav-k/conduit/core#interface.v1"
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Interface",
    "metadata": {
      "name": "extra"
    },
    "from": "person"
  }
]
