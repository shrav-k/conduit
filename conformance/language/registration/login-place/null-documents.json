[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Type",
    "metadata": {
      "name": "shared-agent.v1"
    },
    "spec": {
      "family": "Agent",
      "schema": {
        "type": "object",
        "properties": {
          "login": {
            "$ref": "github.com/shrav-k/conduit/core#resource-reference.v1"
          }
        },
        "required": [
          "login"
        ]
      },
      "loginResource": {
        "place": "/login"
      },
      "offers": []
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "candidate"
    },
    "spec": {
      "type": "#shared-agent.v1",
      "config": {
        "login": "unset"
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "new-worker"
    },
    "from": "candidate",
    "owner": "workers"
  }
]
