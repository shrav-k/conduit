[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Pool",
    "metadata": {
      "name": "pool"
    },
    "spec": {
      "type": "github.com/shrav-k/conduit/core#pool.v1"
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Pool",
    "metadata": {
      "name": "p"
    },
    "from": "pool"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Type",
    "metadata": {
      "name": "agent.v1"
    },
    "spec": {
      "family": "Agent",
      "schema": {
        "type": "object"
      },
      "offers": [],
      "requires": []
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "admin"
    },
    "spec": {
      "capability": "github.com/shrav-k/conduit/core#pool-management.v1",
      "operations": [
        "github.com/shrav-k/conduit/core#inspect.v1"
      ]
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "agent"
    },
    "spec": {
      "type": "#agent.v1",
      "inputs": {
        "pool": {
          "schema": {
            "$ref": "github.com/shrav-k/conduit/core#pool-reference.v1"
          },
          "to": [
            "/conduits/admin/target"
          ]
        }
      },
      "conduits": {
        "admin": {
          "from": "admin"
        }
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Agent",
    "metadata": {
      "name": "a"
    },
    "from": "agent",
    "arguments": {
      "pool": "p"
    }
  }
]
