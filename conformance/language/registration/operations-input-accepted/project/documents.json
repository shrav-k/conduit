[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "access-link"
    },
    "spec": {
      "capability": "github.com/shrav-k/conduit/core#access-control.v1",
      "operations": [
        "github.com/shrav-k/conduit/core#open.v1"
      ],
      "inputs": {
        "ops": {
          "schema": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "to": [
            "/operations"
          ]
        }
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "c"
    },
    "from": "access-link",
    "consumer": {
      "kind": "Interface",
      "name": "root"
    },
    "target": {
      "kind": "Resource",
      "name": "access"
    },
    "arguments": {
      "ops": [
        "github.com/shrav-k/conduit/core#open.v1"
      ]
    }
  }
