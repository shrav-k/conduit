[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Requirement",
    "metadata": {
      "name": "custom.v1"
    },
    "spec": {
      "inputs": {
        "options": {
          "schema": {
            "type": "object",
            "properties": {
              "pool": {
                "$ref": "github.com/shrav-k/conduit/core#pool-reference.v1",
                "default": "system"
              }
            }
          },
          "default": {}
        },
        "needed": {
          "schema": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "access-link"
    },
    "spec": {
      "capability": "github.com/shrav-k/conduit/core#access-control.v1",
      "operations": [
        "github.com/shrav-k/conduit/core#open.v1"
      ],
      "requirements": {
        "limit": {
          "requirement": "#custom.v1",
          "arguments": {
            "needed": "yes"
          }
        }
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "c"
    },
    "from": "access-link",
    "consumer": {
      "kind": "Interface",
      "name": "root"
    },
    "target": {
      "kind": "Resource",
      "name": "access"
    }
  }
]
