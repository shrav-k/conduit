              "contracts": {
                "runtime-provider.v1": {
                  "apiVersion": "github.com/shrav-k/conduit/v0",
                  "kind": "Capability",
                  "metadata": {
                    "name": "runtime-provider.v1",
                    "description": "What a runtime provider offers: running an instance's implementation item, as a run named by the instance's ID, stopping that run and reporting its state. An Agent or a Resource names the runtime provider that runs it by its standard argument `runtime`; with none, the engine's own runner runs it. The server of every run that a runtime provider makes stands behind its gate, which admits a request only with the proof of an enforcement point and keeps everything else on the run's machine from the server, and what answers at the run's `url` proves by TLS, with the run's certificate, that it serves the instance; its contract names the means, and how long the gate takes to close a server's stream once the connection from the enforcement point has gone silent. No Conduit lists these operations: the engine alone invokes them."
                  },
                  "spec": {
                    "operations": [
                      "github.com/shrav-k/conduit/core#run.v1",
                      "github.com/shrav-k/conduit/core#stop.v1",
                      "github.com/shrav-k/conduit/core#inspect-run.v1"
                    ]
                  }
                }
              },
              "exports": [
                "runtime-provider.v1"
              ]
            }
          }
        },
