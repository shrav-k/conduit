[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Pool",
    "metadata": {
      "name": "pool"
    },
    "spec": {
      "type": "github.com/shrav-k/conduit/core#pool.v1",
      "entries": {
        "one": {
          "from": "resource",
          "arguments": {
            "peer": {
              "entry": "two"
            }
          }
        },
        "two": {
          "from": "resource"
        }
      }
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Pool",
    "metadata": {
      "name": "p"
    },
    "from": "pool"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Type",
    "metadata": {
      "name": "resource.v1"
    },
    "spec": {
      "family": "Resource",
      "schema": {
        "type": "object"
      },
      "offers": [],
      "requires": []
    }
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Resource",
    "metadata": {
      "name": "resource"
    },
    "spec": {
      "type": "#resource.v1",
      "inputs": {
        "peer": {
          "schema": {
            "$ref": "github.com/shrav-k/conduit/core#resource-reference.v1"
          },
          "optional": true,
          "to": [
            "/config/peer"
          ]
        }
      }
    }
  }
]
