[
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Interface",
    "metadata": {
      "name": "auditor"
    },
    "from": "basis"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "auditor--scope"
    },
    "consumer": {
      "kind": "Interface",
      "name": "auditor"
    },
    "target": {
      "kind": "Pool",
      "name": "library"
    },
    "from": "github.com/shrav-k/conduit/core#pool-view",
    "as": "scope"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "auditor--files"
    },
    "consumer": {
      "kind": "Interface",
      "name": "auditor"
    },
    "target": {
      "kind": "Resource",
      "name": "files"
    },
    "from": "example.org/s1/filesystem#read",
    "as": "files"
  },
  {
    "apiVersion": "github.com/shrav-k/conduit/v0",
    "kind": "Conduit",
    "metadata": {
      "name": "auditor--local"
    },
    "consumer": {
      "kind": "Interface",
      "name": "auditor"
    },
    "target": {
      "kind": "Pool",
      "name": "library"
    },
    "from": "read-local",
    "as": "local"
  }
]
