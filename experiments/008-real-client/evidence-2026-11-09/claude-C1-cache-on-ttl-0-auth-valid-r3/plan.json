{
  "program": "claude",
  "args": [
    "--print",
    "--model",
    "sonnet",
    "--setting-sources",
    "project",
    "--settings",
    "<runs>/claude-C1-cache-on-ttl-0-auth-valid-r3/settings.json",
    "--strict-mcp-config",
    "--mcp-config",
    "<runs>/claude-C1-cache-on-ttl-0-auth-valid-r3/mcp.json",
    "--tools",
    "",
    "--allowedTools",
    "mcp__stub__*",
    "--no-session-persistence",
    "--output-format",
    "stream-json",
    "--verbose",
    "--include-partial-messages",
    "--disable-slash-commands",
    "Use only the experiment stub's MCP tools. Call files.read.v1 with path hello.txt, then control.next.v1 with {}, then files.read.v1 with path hello.txt again, in that order. Attempt the final call even if the tool list changed. Report what happened. Do not substitute shell commands or other tools for the requested calls."
  ],
  "env": {
    "CONDUIT_IDENTITY_DIR": "<runs>/claude-C1-cache-on-ttl-0-auth-valid-r3/identity",
    "CONDUIT_URL": "http://127.0.0.1:51312/",
    "MCP_DISCOVERY_CACHE": "1",
    "TMPDIR": "<runs>/claude-C1-cache-on-ttl-0-auth-valid-r3/tmp",
    "npm_config_cache": "<runs>/claude-C1-cache-on-ttl-0-auth-valid-r3/npm-cache"
  },
  "env_remove": [
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "CLAUDECODE",
    "MCP_CONFIG"
  ],
  "cwd": "<runs>/claude-C1-cache-on-ttl-0-auth-valid-r3/lab"
}