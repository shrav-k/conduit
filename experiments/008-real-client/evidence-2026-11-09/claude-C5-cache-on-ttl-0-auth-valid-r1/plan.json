{
  "program": "claude",
  "args": [
    "--print",
    "--model",
    "sonnet",
    "--setting-sources",
    "project",
    "--settings",
    "<runs>/claude-C5-cache-on-ttl-0-auth-valid-r1/settings.json",
    "--strict-mcp-config",
    "--mcp-config",
    "<runs>/claude-C5-cache-on-ttl-0-auth-valid-r1/mcp.json",
    "--tools",
    "",
    "--allowedTools",
    "mcp__stub__*",
    "--no-session-persistence",
    "--output-format",
    "stream-json",
    "--verbose",
    "--include-partial-messages",
    "--disable-slash-commands",
    "Use only the experiment stub's MCP tools. Call control.next.v1 with {}, then use the newly opened tool notes.read.v1 with path hello.txt. Discover the new tool if your client permits it. Report what happened. Do not substitute shell commands or other tools for the requested calls."
  ],
  "env": {
    "CONDUIT_IDENTITY_DIR": "<runs>/claude-C5-cache-on-ttl-0-auth-valid-r1/identity",
    "CONDUIT_URL": "http://127.0.0.1:51648/",
    "MCP_DISCOVERY_CACHE": "1",
    "TMPDIR": "<runs>/claude-C5-cache-on-ttl-0-auth-valid-r1/tmp",
    "npm_config_cache": "<runs>/claude-C5-cache-on-ttl-0-auth-valid-r1/npm-cache"
  },
  "env_remove": [
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "CLAUDECODE",
    "MCP_CONFIG"
  ],
  "cwd": "<runs>/claude-C5-cache-on-ttl-0-auth-valid-r1/lab"
}