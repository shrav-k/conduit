{
  "program": "codex",
  "args": [
    "exec",
    "--ignore-user-config",
    "--strict-config",
    "--ignore-rules",
    "--disable",
    "apps",
    "--sandbox",
    "read-only",
    "--ephemeral",
    "--skip-git-repo-check",
    "--json",
    "--color",
    "never",
    "--output-last-message",
    "<runs>/codex-C3-cache-off-ttl-0-auth-valid-r3/final.txt",
    "-c",
    "mcp_servers.stub.url=\"http://127.0.0.1:52135/\"",
    "-c",
    "mcp_servers.stub.http_headers_helper=\"'<lab>' '--headers-helper' '--identity-dir' '<runs>/codex-C3-cache-off-ttl-0-auth-valid-r3/identity' '--helper-log' '<runs>/codex-C3-cache-off-ttl-0-auth-valid-r3/helper.jsonl'\"",
    "-c",
    "mcp_servers.stub.startup_readiness=\"connection\"",
    "-c",
    "mcp_servers.stub.required=true",
    "-c",
    "mcp_servers.stub.default_tools_approval_mode=\"approve\"",
    "-c",
    "model_reasoning_effort=\"low\"",
    "-c",
    "web_search=\"disabled\"",
    "Use only the experiment stub's MCP tools. Call files.read.v1 with path fail.txt. Report what happened. Do not substitute shell commands or other tools for the requested calls."
  ],
  "env": {
    "CONDUIT_IDENTITY_DIR": "<runs>/codex-C3-cache-off-ttl-0-auth-valid-r3/identity",
    "CONDUIT_URL": "http://127.0.0.1:52135/",
    "TMPDIR": "<runs>/codex-C3-cache-off-ttl-0-auth-valid-r3/tmp",
    "npm_config_cache": "<runs>/codex-C3-cache-off-ttl-0-auth-valid-r3/npm-cache"
  },
  "env_remove": [
    "ANTHROPIC_API_KEY",
    "OPENAI_API_KEY",
    "CLAUDECODE",
    "MCP_CONFIG"
  ],
  "cwd": "<runs>/codex-C3-cache-off-ttl-0-auth-valid-r3/lab"
}